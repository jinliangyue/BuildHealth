# BuildHealth · Frontend Dockerfile
# ==================================
# Multi-stage build: Node 20 produces the static bundle in /app/dist,
# then nginx:alpine serves it and reverse-proxies /api/* to the backend
# service. The build stage is discarded; only the slim nginx layer
# ships, keeping the image around 40 MB.
#
# Build:    docker build -f Dockerfile.frontend -t buildhealth-frontend .
# Run:      docker run --rm -p 8080:80 buildhealth-frontend
#
# In docker-compose, the upstream is the `backend` service via Docker DNS.

# --------------------------------------------------------------------- build
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies first to cache them across source-only changes
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

# Build the production bundle (tsc + vite build, per package.json)
COPY frontend/ ./
RUN npm run build

# ---------------------------------------------------------------------- serve
FROM nginx:1.27-alpine

# Replace the default site config with one that:
#   1. Serves the SPA from /usr/share/nginx/html
#   2. Proxies /api/* to the `backend` service (Docker DNS)
#   3. Falls back to index.html for client-side routes (e.g. /retrofit)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Static assets from the build stage
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

# nginx:alpine's default CMD is fine; it serves the config we just dropped in.
