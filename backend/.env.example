# BuildHealth Backend Environment Variables
# 复制为 .env 后按需修改

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite:///../../data/buildhealth.db

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Analytics
BHI_VERSION=v0.1

# Logging
LOG_LEVEL=INFO

# === BuildHealth AI Engineering Assistant · Phase 6A ===
# 默认 mock, 无任何 key 也能跑. 设置后切到真实 LLM (OpenAI-compatible).
# NEVER commit real keys to Git. 本文件仅作模板, 真实值放本地 .env.

# AI_PROVIDER: "mock" (default) or "openai-compatible"
AI_PROVIDER=mock

# Required when AI_PROVIDER=openai-compatible:
# (留空, 由用户本地配置)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional tuning
AI_REQUEST_TIMEOUT=30
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.2
